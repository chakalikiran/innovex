{
  "entities": {
    "ClearanceRequest": {
      "title": "ClearanceRequest",
      "description": "Student No-Dues clearance application across departments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "studentEmail": { "type": "string", "maxLength": 120 },
        "studentRollNo": { "type": "string", "maxLength": 32 },
        "program": { "type": "string", "maxLength": 100 },
        "academicYear": { "type": "string", "maxLength": 32 },
        "phone": { "type": "string", "maxLength": 20 },
        "selectedDepartments": { "type": "array" },
        "departmentStatuses": { "type": "object" },
        "overallStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "progressPercent": { "type": "number" },
        "certificateId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentRollNo", "studentName", "studentEmail", "overallStatus"]
    },
    "AuditRecord": {
      "title": "AuditRecord",
      "description": "Immutable log record of departmental clearance actions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "requestId": { "type": "string", "maxLength": 64 },
        "studentRollNo": { "type": "string", "maxLength": 32 },
        "department": { "type": "string", "maxLength": 32 },
        "action": { "type": "string", "maxLength": 32 },
        "actorEmail": { "type": "string", "maxLength": 120 },
        "actorName": { "type": "string", "maxLength": 100 },
        "actorRole": { "type": "string", "maxLength": 32 },
        "remarks": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string" }
      },
      "required": ["requestId", "department", "action", "actorRole"]
    },
    "CertificateRecord": {
      "title": "CertificateRecord",
      "description": "Official digitally signed university No-Dues certificate",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "requestId": { "type": "string", "maxLength": 64 },
        "studentName": { "type": "string", "maxLength": 100 },
        "studentRollNo": { "type": "string", "maxLength": 32 },
        "program": { "type": "string", "maxLength": 100 },
        "academicYear": { "type": "string", "maxLength": 32 },
        "issuedAt": { "type": "string" },
        "issuer": { "type": "string", "maxLength": 120 },
        "verificationHash": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["valid", "revoked"] }
      },
      "required": ["id", "requestId", "studentName", "studentRollNo", "status"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Student notification regarding clearance changes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "recipientEmail": { "type": "string", "maxLength": 120 },
        "studentRollNo": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "maxLength": 32 },
        "requestId": { "type": "string", "maxLength": 64 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["recipientEmail", "title", "message"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access control metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["student", "library_officer", "hostel_officer", "sports_officer", "accounts_officer", "admin"] },
        "department": { "type": "string", "maxLength": 32 },
        "studentRollNo": { "type": "string", "maxLength": 32 },
        "employeeId": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "EmployeeIndex": {
      "title": "EmployeeIndex",
      "description": "Employee ID lookup mapping for authority sign-in",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 32 },
        "department": { "type": "string", "maxLength": 32 },
        "displayName": { "type": "string", "maxLength": 100 }
      },
      "required": ["employeeId", "email", "role"]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Student directory registry entry",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "rollNo": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "rollNo", "name", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Registered user accounts and role permissions"
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/StudentProfile" },
      "description": "Student directory records"
    },
    "/employee_index/{employeeId}": {
      "schema": { "$ref": "#/entities/EmployeeIndex" },
      "description": "Lookup index mapping employee ID to account email"
    },
    "/clearance_requests/{requestId}": {
      "schema": { "$ref": "#/entities/ClearanceRequest" },
      "description": "Collection of student No-Dues clearance applications"
    },
    "/audit_logs/{auditId}": {
      "schema": { "$ref": "#/entities/AuditRecord" },
      "description": "Immutable departmental verification audit trail"
    },
    "/certificates/{certificateId}": {
      "schema": { "$ref": "#/entities/CertificateRecord" },
      "description": "Official verified digital certificates"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Real-time student alerts and clearance updates"
    }
  }
}
